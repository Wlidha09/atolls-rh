{
  "name": "atolls-hr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "start": "next start",
    "seed": "node --env-file=.env.local scripts/seed.js",
    "notify": "node --env-file=.env.local scripts/notify.js",
    "test": "node --test tests/*.test.js",
    "worker": "node --env-file=.env.local scripts/worker.js",
    "db:setup": "node --env-file=.env.local scripts/setup-db.js",
    "db:check": "node --env-file=.env.local scripts/check-db.js",
    "db:migrate:turso": "node --env-file=.env.local scripts/migrate-turso.js"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "jose": "^6.1.0",
    "next": "^16.2.0",
    "nodemailer": "10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  }
}
